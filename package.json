{
  "name": "school-rg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:ios:init": "tauri ios init",
    "app:ios:build": "tauri ios build",
    "check:platform": "node scripts/check-platform-config.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check:art": "node scripts/validate-art.mjs && node scripts/validate-literature-rig.mjs && node scripts/validate-music-rig.mjs && node scripts/validate-art-rig.mjs",
    "art:review-board": "node scripts/art-review-board.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run check:art && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
